# iCore — configuración para Hostinger (LiteSpeed/Apache).
# El sitio es una sola página (index.html) con secciones por # (/#nodo, /#plexo, /#contacto).

Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
# Una URL que no existe muestra la portada, con código 404.
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # URLs de las versiones anteriores → su sección en la página única
  RewriteRule ^nodo(/.*)?$ https://icoregroup.tech/#nodo [R=301,L,NC,NE]
  RewriteRule ^(plexo|hen|vita)(/.*)?$ https://icoregroup.tech/#plexo [R=301,L,NC,NE]
  RewriteRule ^contacto(/.*)?$ https://icoregroup.tech/#contacto [R=301,L,NC,NE]
  RewriteRule ^NODO\sContacto\.html$ https://icoregroup.tech/#contacto [R=301,L,NC,NE]
  RewriteRule ^nosotros(/.*)?$ https://icoregroup.tech/ [R=301,L,NC]

  # Dominio canónico: somo-icore.com y www → icoregroup.tech
  RewriteCond %{HTTP_HOST} !^icoregroup\.tech$ [NC]
  RewriteRule ^ https://icoregroup.tech%{REQUEST_URI} [R=301,L,NE]

  # Forzar HTTPS (contempla la CDN de Hostinger, que termina TLS adelante)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ https://icoregroup.tech/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Videos y pósters: una semana. La página: siempre revalidar.
  <FilesMatch "\.(mp4|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/json
</IfModule>

# No exponer archivos de configuración
<FilesMatch "^\.git.*$">
  Require all denied
</FilesMatch>
